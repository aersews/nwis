# Absolute base URL of the NWIS FastAPI service.
#
# Leave unset in development: the Vite dev server proxies /api and
# /ws to NWIS_BACKEND (default http://127.0.0.1:8000), so the
# browser only ever talks to the dev server's own origin.
#
# Set it when the bundle is served from somewhere other than the
# backend host — for example a static build opened over the LAN.
VITE_API_BASE=http://127.0.0.1:8000
